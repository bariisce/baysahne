# ---------------------------------------------------------------------------
# Bay Sahne — environment template. Copy to `.env` and fill in real values.
# NEVER commit `.env`. Every value below is a placeholder.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development

# Database (docker compose `db` service listens on 127.0.0.1:5433)
POSTGRES_USER=baysahne
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baysahne
DATABASE_URL=postgresql+psycopg://baysahne:change-me@127.0.0.1:5433/baysahne
TEST_DATABASE_URL=postgresql+psycopg://baysahne:change-me@127.0.0.1:5433/baysahne_test
# Requests fail fast with 503 instead of hanging when the database is down or the pool is exhausted
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=10

# Public base URL of the API (used to build absolute media URLs and legal page links).
# Leave empty in development: media URLs always follow the address each request came in on
# (phone on the LAN, admin on localhost), so a changed IP needs no reconfiguration. A value set
# here or on the command line is ignored for requests in development, exactly so that an old
# address cannot break images. Required (https, a domain name) in staging/production.
PUBLIC_API_BASE_URL=
# Public base URL of the admin panel (used in invitation / password-reset links)
ADMIN_BASE_URL=http://localhost:3100
# Comma-separated origins allowed to call the API from a browser (admin panel origin only)
CORS_ALLOWED_ORIGINS=http://localhost:3100

# Session cookie. In production COOKIE_SECURE must be true (HTTPS only).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Media storage: local | s3
MEDIA_STORAGE=local
MEDIA_LOCAL_ROOT=./var/media
MEDIA_MAX_UPLOAD_MB=15
# S3-compatible storage (only when MEDIA_STORAGE=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL from which stored objects are served (CDN or bucket website endpoint)
S3_PUBLIC_BASE_URL=

# Email: console (development only) | file (development only) | smtp
EMAIL_BACKEND=console
EMAIL_FROM="Bay Sahne <no-reply@example.invalid>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Push: log (development: records, never sends) | expo (real delivery) | fake (tests)
PUSH_PROVIDER=log
# Optional: Expo access token if "Enhanced push security" is enabled in the Expo project
EXPO_ACCESS_TOKEN=

# Worker loop interval in seconds
WORKER_INTERVAL_SECONDS=30
